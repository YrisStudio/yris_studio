# Formulaire de demande (à définir aussi dans Vercel > Settings > Environment Variables)
RESEND_API_KEY=
# Optionnel : par défaut, les formulaires arrivent sur contact@yris-studio.com
CONTACT_TO_EMAIL=
# Optionnel : expéditeur sur un domaine vérifié dans Resend
CONTACT_FROM_EMAIL="Yris <contact@yris-studio.com>"

# Comptes clients (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
